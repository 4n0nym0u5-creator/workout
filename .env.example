# Postgres connection string. Neon injects DATABASE_URL; Supabase Marketplace
# injects POSTGRES_URL / POSTGRES_PRISMA_URL. The API accepts any of these.
# For local `vercel dev`, pull with:
#   npx vercel env pull .env.local --yes
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
